# Copy to `.env` and fill in. `.env` is gitignored - never commit real keys.

# Required to sign session cookies in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a known development default is used and a warning is logged.
SECRET_KEY=

# Optional. Override the SQLite path (default: instance/app.db).
# DATABASE_URL=

# AI chat assistant (optional - the app works without it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated extra models to try after the built-in fallbacks.
GEMINI_FALLBACK_MODELS=

# Per-user (or per-IP) chat requests allowed per minute. 0 disables the limit.
AI_RATE_LIMIT_PER_MINUTE=20

# Development server (app.py when run directly). Keep FLASK_DEBUG off in production.
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
